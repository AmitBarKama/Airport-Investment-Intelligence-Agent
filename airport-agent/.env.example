# ── Which model the agent uses ──────────────────────────────────────────────
# One line, LangChain's "provider:model" form. Switching provider is this line
# and nothing else in the codebase.
#
#   LLM=google_genai:gemini-3.5-flash-lite
#   LLM=openai:gpt-4o-mini
#   LLM=groq:llama-3.3-70b-versatile
#   LLM=anthropic:claude-sonnet-4-6
#   LLM=ollama:llama3
#
# Requires `make install` (LangChain). Without it, and without any key, the app
# still runs on its built-in keyless planner.
LLM=google_genai:gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2

# Each provider reads its own conventional key variable.
# GOOGLE_API_KEY=      # Google AI Studio: https://aistudio.google.com/apikey
# OPENAI_API_KEY=
# GROQ_API_KEY=          # free, no card: https://console.groq.com
# ANTHROPIC_API_KEY=

# ── Disclosed assumptions (all overridable) ────────────────────────────────
LONG_HAUL_NMI=2500
SHORT_HAUL_NMI=800
MAX_AGENT_HOPS=5
PORT=8000

# ── Speech (optional) ───────────────────────────────────────────────────────
# Browser voices are free but sound synthetic. Either key routes speech through
# a neural voice, proxied server-side so it never reaches the browser.
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# ── Web context (optional) ──────────────────────────────────────────────────
# Powers `capital_programmes`: what an airport has ANNOUNCED it will build.
# Qualitative and cited; never an input to any score. Without a key it falls
# back to the curated constraints file.
# TAVILY_API_KEY=        # https://tavily.com
# BRAVE_API_KEY=
